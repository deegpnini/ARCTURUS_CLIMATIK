!*.md
!*.py

# --- MODELOS TREINADOS ---
*.pkl
*.cbm
*.h5
*.pt
*.pth
*.onnx
*.joblib

# --- PYTHON ---
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# --- NOTEBOOKS ---
.ipynb_checkpoints/

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- SISTEMA ---
.DS_Store
Thumbs.db

# --- BACKUPS LOCAIS ---
*.bak
*.old
*.orig
*.bak_*

# --- DATASETS INTERNOS (nunca subir) ---
core/arcturus/DATASETS/
core/arcturus/*.csv
core/arcturus/*.nc
core/arcturus/*.CSV
dados/sar/DATASETS/
