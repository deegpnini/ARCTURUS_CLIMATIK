# --- SEGREDOS (NUNCA SUBIR) ---
.env
.env.*
*.env
*token*
*secret*
*credential*
*.key
*.pem
token.json

# --- DADOS BRUTOS (NUNCA SUBIR) ---
cache/
dados/
modulos/
logs/
relatorios/
backup_completo/
backup_*/
backup/
*.csv
*.jsonl

# --- EXCEÇÕES (arquivos específicos que SOBEM) ---
